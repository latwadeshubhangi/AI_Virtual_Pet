# Copy this file to `.env` and fill in ONE key. `.env` is git-ignored.
# Mochi works 100% offline without any key - this is purely optional.

# ---- Google Gemini (free tier) -------------------------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- OpenAI ---------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Groq (fast, free tier) ----------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# ---- Anthropic Claude ----------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- OpenRouter / DeepSeek / Mistral -------------------------------------
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# ---- Optional settings ---------------------------------------------------
# AI_PROVIDER=Gemini
# AI_MODEL=gemini-2.0-flash
# OPENAI_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
# AI_TIMEOUT=45
